# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta Pixel + Conversions API
# Pixel ID: lấy từ Events Manager > Data Sources > Pixel
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id

# CAPI Token: Events Manager > Data Sources > Pixel > Settings > Conversions API > Generate Access Token
META_CAPI_TOKEN=your-capi-token

# (Tuỳ chọn) Test Event Code: dùng khi test CAPI — xoá khi go live
# META_CAPI_TEST_CODE=TEST12345
